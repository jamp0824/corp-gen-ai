# ──────────────────────────────────────────────
# IBK BOX — 환경 변수 설정 예시
# 이 파일을 .env 로 복사 후 값을 채우세요.
# cp .env.example .env
# ──────────────────────────────────────────────

# ── Anthropic API ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 사용할 Claude 모델
# 최신: claude-sonnet-4-6  |  고성능: claude-opus-4-7
LLM_MODEL=claude-sonnet-4-6

# ── 데이터베이스 ─────────────────────────────────
# SQLite (개발/로컬): sqlite+aiosqlite:///./data/ibkbox.db
# PostgreSQL (운영):  postgresql+asyncpg://user:password@localhost:5432/ibkbox
DATABASE_URL=sqlite+aiosqlite:///./data/ibkbox.db

# ── 크롤링 설정 ──────────────────────────────────
CRAWL_BUDGET_SEC=25.0
CRAWL_MAX_PAGES=12
CRAWL_CONCURRENCY=5
CRAWL_PAGE_TIMEOUT=4.0

# ── 전체 요청 deadline ──────────────────────────
REQUEST_DEADLINE_SEC=58.0

# ── 앱 설정 ──────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── 프론트엔드 ───────────────────────────────────
# Next.js에서 FastAPI 백엔드 URL (Docker 내부: http://backend:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
